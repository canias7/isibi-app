#!/bin/bash
# THE TOOLS ON CODER'S MACHINE AND THEIR VERSIONS, like `check-tools` on Claude
# Code's machine (owner, 2026-11-07: "can we install all the tools we need?").
show() {
  local name="$1"; shift
  local out
  if out=$("$@" 2>&1 | grep -v '^Picked up ' | head -n 1) && [ -n "$out" ]; then
    printf '  ok  %-16s %s\n' "$name" "$out"
  else
    printf '  --  %-16s not installed\n' "$name"
  fi
}
section() { printf '\n%s\n' "$1"; }

echo "Coder's machine: $(. /etc/os-release && echo "$PRETTY_NAME") on $(uname -m)"
section "Python"
show python3 python3 --version
show pip pip3 --version
show uv uv --version
show poetry poetry --version
show black black --version
show ruff ruff --version
show mypy mypy --version
show pytest pytest --version
show conan conan --version
section "JavaScript"
show node node --version
show "node 24" /opt/node24/bin/node --version
show npm npm --version
show yarn yarn --version
show pnpm pnpm --version
show bun bun --version
show eslint eslint --version
show prettier prettier --version
show typescript tsc --version
section "Ruby (rbenv: 3.1, 3.2, 3.3)"
show ruby ruby --version
show rbenv rbenv --version
show bundler bundle --version
section "PHP"
show php php --version
show composer composer --version
section "Java"
show java java -version
show maven mvn --version
show gradle sh -c 'gradle --version | grep "^Gradle"'
section "Go and Rust"
show go go version
show rustc rustc --version
show cargo cargo --version
section "C/C++"
show gcc gcc --version
show clang clang --version
show cmake cmake --version
show ninja ninja --version
section "Docker (rootless: the engine starts with the first docker command)"
show docker /usr/bin/docker --version
show "docker compose" /usr/bin/docker compose version
section "Databases (start them: service postgresql start, service redis-server start)"
show postgresql psql --version
show redis redis-server --version
section "Browser"
show chrome google-chrome --version
show chromedriver chromedriver --version
section "Media and documents"
show ffmpeg sh -c 'ffmpeg -version | head -n 1'
show imagemagick sh -c 'convert -version | head -n 1'
show pdftotext sh -c 'pdftotext -v 2>&1 | head -n 1'
show pandoc sh -c 'pandoc --version | head -n 1'
show "python libraries" python3 -c 'import numpy, pandas, openpyxl, docx, pptx, pypdf, pdfplumber, reportlab, markitdown, requests, PIL; print("numpy pandas openpyxl docx pptx pypdf pdfplumber reportlab markitdown requests pillow")'
section "Browser automation"
show playwright playwright --version
show xvfb-run sh -c 'command -v xvfb-run'
section "Debugging"
show strace sh -c 'strace -V | head -n 1'
show lsof sh -c 'lsof -v 2>&1 | grep -m 1 revision'
show valgrind valgrind --version
show netcat sh -c 'command -v nc'
section "Other"
show git git --version
show git-lfs git lfs version
show gh gh --version
show jq jq --version
show yq yq --version
show ripgrep rg --version
show sqlite3 sqlite3 --version
show tmux tmux -V
show vim sh -c 'vim --version | head -n 1'
show nano nano --version
