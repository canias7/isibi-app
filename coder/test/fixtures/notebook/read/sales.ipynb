    "# Monthly sales\n",
    "Totals by month, from sales.csv."
   ]
  },
  {
   "cell_type": "code",
   "id": "load",
   "execution_count": 1,
   "metadata": {},
   "source": [
    "import pandas as pd\n",
    "df = pd.read_csv('sales.csv')\n",
    "print(len(df), 'rows')\n",
    "df.groupby('month').total.sum()"
   ],
