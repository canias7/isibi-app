{
  "name": "isibi-app",
  "compatibility_date": "2026-07-02",
  "main": "worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Run the Worker for every request (including static assets) so the
    // harden() wrapper can attach security headers to HTML/JS/CSS too — by
    // default Cloudflare serves matching assets directly and skips the Worker.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "gofarther.dev", "custom_domain": true },
    { "pattern": "www.gofarther.dev", "custom_domain": true },
    // CUSTOM DOMAINS. The two entries above are `custom_domain` routes, each
    // matching ONE exact hostname, and a customer's `sharpfadebarbers.com` is
    // neither — so it matches no route, falls through to the Cloudflare for SaaS
    // fallback origin, finds the originless `AAAA 100::` there, and times out.
    // `*/*` is Cloudflare's documented pattern for this: it routes everything
    // entering the zone to the Worker INCLUDING custom hostnames.
    //
    // ORDER MATTERS, and it was measured rather than reasoned. Added before the
    // zone had Cloudflare for SaaS, this failed the deploy at
    // `PUT /accounts/…/workers/scripts/isibi-app/routes` — the script and both
    // custom domains deployed and the routes call did not, because a bare `*`
    // hostname matches nothing that can exist on a zone with no custom
    // hostnames. The fallback origin comes FIRST. It is `saas.gofarther.dev`
    // (`AAAA 100::`, proxied) and it reported `status active` before this line
    // was enabled on 2026-08-07.
    //
    // IT HAS TO LIVE HERE rather than being added by hand or by the setup
    // script: wrangler publishes routes with a PUT that DELETES any it was not
    // told about, so an out-of-band route survives exactly until the next
    // deploy.
    { "pattern": "*/*", "zone_name": "gofarther.dev" },

    // ── THE SITE ZONE, `gofarther.app` — LIVE 2026-08-09 ──────────────────────
    //
    // Every published site has an automatic address at `<slug>.gofarther.app`.
    // `siteHostSlug` in site-domains.mjs rewrites that Host to `/s/<slug>/`;
    // this route is what brings those requests to the script at all.
    //
    // IT MUST FLIP TOGETHER WITH `SITE_ZONE_LIVE` in site-domains.mjs, and
    // `test/site-zone.test.mjs` fails if either moves alone: a live route with
    // the flag off is a zone serving sites nobody is given the address of, and
    // the flag on with no route is every customer handed a link that times out.
    //
    // ENABLED ONLY AFTER THE ZONE AND ITS DNS, in that order, because the block
    // above records at first hand what happens otherwise — a route naming a
    // zone this account does not hold fails the routes PUT, which fails the
    // WHOLE deploy with an error naming a feature the change never touched.
    // That cost three merges on 2026-08-07. Verified before this line was
    // added: the zone reads Active in the same account (the deploy's read-only
    // report found it), `*` and `@` are both `AAAA 100::` PROXIED, and a real
    // HTTPS request to a subdomain answered with `ssl_verify_result=0` — so the
    // Universal SSL certificate was issued and covers the wildcard. The 522
    // underneath it was Cloudflare finding no origin, which is precisely what
    // this line fixes.
    //
    // NO CLOUDFLARE FOR SAAS AND NO CERTIFICATE PER SITE. These are subdomains
    // of a zone we own, so Universal SSL covers them free — `*.gofarther.app`
    // is one wildcard level, which is exactly what `<slug>.gofarther.app` is
    // and exactly why `siteHostSlug` refuses a second label. Custom domains
    // keep using Cloudflare for SaaS and its 100-hostname allowance; these
    // consume none of it.
    { "pattern": "*/*", "zone_name": "gofarther.app" }
  ],
  // Published Website-Builder sites are stored here (one HTML object per page)
  // and served from the Worker at gofarther.dev/s/<slug>/… (and later custom domains).
  "r2_buckets": [
    { "binding": "SITES_BUCKET", "bucket_name": "isibi-sites" }
  ],
  // Two edge caches, created 2026-08-16. BOTH ARE OPTIONAL BY CONSTRUCTION —
  // every reader checks the binding and falls back — which is what let the code
  // for each ship long before the namespace existed.
  //
  //   SITE_ROUTES     slug -> connection string. Without it, answering "which
  //                   Neon database is this slug?" costs TWO cross-region
  //                   Supabase calls on every visitor read, for a value written
  //                   once at build time. Measured before KV: 0.27-2.00s,
  //                   median 1.05s, with only 3 of 12 requests warm.
  //   SITE_API_CACHE  a published site's third-party API answers. Without it a
  //                   declared `cacheSeconds: 3600` is honoured PER ISOLATE, so
  //                   a low-traffic site is close to uncached and the OWNER'S
  //                   third-party quota is spent once per isolate per window.
  //
  // Only the connection string and the API answer live here, never a schema: KV
  // is eventually consistent, which is harmless for a value fixed at build time
  // and a real bug for one a revise changes — a stale schema 404s a site's own
  // new tables. The schema keeps its 15s in-isolate cache and its `_meta` read.
  "kv_namespaces": [
    { "binding": "SITE_ROUTES", "id": "5fdb805d4ead430cbb5b8824f766a76b" },
    { "binding": "SITE_API_CACHE", "id": "d1f7c9b6ecce4231a3733f4a95dc7d6f" }
  ],
  // Where a site's OWN Worker lives, one script per site. Created 2026-08-17 by
  // `dispatch namespace setup`; the preflight reported `ok created the
  // namespace` before this line was added, which is the order that matters.
  //
  // A BINDING THAT NAMES SOMETHING NONEXISTENT FAILS THE WHOLE DEPLOY, not just
  // itself — that is how three merges shipped nothing on 2026-08-07, with the
  // error naming a feature none of them touched. So this goes in AFTER the
  // namespace exists, never in the same change that creates it.
  //
  // OPTIONAL BY CONSTRUCTION, exactly like the two KV namespaces above: the
  // serve path checks the binding and falls back to R2. That is what makes it
  // safe for a site with no uploaded script — which is every site that exists
  // today — to keep being served from static files as if this were not here.
  "dispatch_namespaces": [
    { "binding": "SITE_WORKERS", "namespace": "gofarther-sites" }
  ],
  // Outbound mail. Cloudflare Email Service, from 2026-07-30 — the previous
  // provider was stopped.
  //
  // A BINDING rather than the REST API, which is the reason to prefer Cloudflare
  // here at all: there is no token to mint, store in GitHub Actions, upload on
  // every deploy, or rotate. The Supabase Edge Function that sends auth email
  // cannot use this (it runs on Deno, not on Cloudflare) and goes through the REST
  // API with a token instead — the only place one is needed.
  //
  // `env.EMAIL` is undefined until Email Sending is enabled on the account and
  // gofarther.dev is verified as a sending domain, so every caller checks for it and
  // no-ops rather than throwing.
  "send_email": [
    { "name": "EMAIL" }
  ],
  // Game build-service (Phase 3): runs `vite build` on AI-generated kaplay games
  // AND a headless-Chromium runtime smoke test. Image ./builder-game/Dockerfile;
  // the Worker talks to it via the GAME_BUILD_CONTAINER Durable Object binding.
  //
  // Site build-service: the same shape for the rebuilt website builder — the React
  // template with its deps baked in, so a per-site build is `tsr generate` →
  // `tsc --noEmit` → `vite build`. A NEW class name rather than the retired
  // BuildContainer: v4 below deleted that one, and reviving a deleted class is
  // not something a migration list can express.
  //
  // (The two ORIGINAL website-builder containers — BuildContainer →
  // ./builder/Dockerfile, CloneBuildContainer → ./builder/lovable/Dockerfile —
  // were removed 2026-07-27 along with the rest of the builder.)
  "containers": [
    {
      "class_name": "GameBuildContainer",
      "image": "./builder-game/Dockerfile",
      "max_instances": 5,
      "instance_type": "standard-1"
    },
    {
      "class_name": "SiteBuildContainer",
      "image": "./builder/Dockerfile",
      "max_instances": 5,
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "GameBuildContainer", "name": "GAME_BUILD_CONTAINER" },
      { "class_name": "SiteBuildContainer", "name": "SITE_BUILD_CONTAINER" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BuildContainer"] },
    { "tag": "v2", "new_sqlite_classes": ["GameBuildContainer"] },
    { "tag": "v3", "new_sqlite_classes": ["CloneBuildContainer"] },
    // Retires the two builder containers. A Durable Object class that disappears
    // from the Worker without a deleted_classes migration fails the deploy.
    { "tag": "v4", "deleted_classes": ["BuildContainer", "CloneBuildContainer"] },
    { "tag": "v5", "new_sqlite_classes": ["SiteBuildContainer"] }
  ],
  // Auto-reply engine: wake every 2 minutes to answer new inbound DMs for
  // accounts that have DM auto-reply switched on (see scheduled() in worker.js).
  "triggers": { "crons": ["*/2 * * * *"] }
}
