{
  "name": "isibi-app",
  "compatibility_date": "2026-07-02",
  "main": "worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Run the Worker for every request (including static assets) so the
    // harden() wrapper can attach security headers to HTML/JS/CSS too — by
    // default Cloudflare serves matching assets directly and skips the Worker.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "isibi.ai", "custom_domain": true },
    { "pattern": "www.isibi.ai", "custom_domain": true }
  ],
  // Published Website-Builder sites are stored here (one HTML object per page)
  // and served from the Worker at isibi.ai/s/<slug>/… (and later custom domains).
  "r2_buckets": [
    { "binding": "SITES_BUCKET", "bucket_name": "isibi-sites" }
  ],
  // React-builder build-service (Phase 3): a container that runs `vite build` on
  // AI-generated React projects. Image built from ./builder/Dockerfile at deploy;
  // the Worker talks to it via the BUILD_CONTAINER Durable Object binding.
  // instance_type "standard" (4 GiB) so the compile has memory headroom.
  "containers": [
    {
      "class_name": "BuildContainer",
      "image": "./builder/Dockerfile",
      "max_instances": 5,
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "BuildContainer", "name": "BUILD_CONTAINER" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BuildContainer"] }
  ],
  // Auto-reply engine: wake every 2 minutes to answer new inbound DMs for
  // accounts that have DM auto-reply switched on (see scheduled() in worker.js).
  "triggers": { "crons": ["*/2 * * * *"] }
}
