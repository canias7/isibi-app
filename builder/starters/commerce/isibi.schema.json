{
  "tables": [
    {
      "name": "products",
      "access": "admin",
      "columns": [
        { "name": "title", "type": "text", "required": true, "max": 120 },
        { "name": "description", "type": "text", "max": 600 },
        { "name": "price", "type": "real", "required": true, "min": 0 },
        { "name": "compare_price", "type": "real", "min": 0 },
        { "name": "image", "type": "text", "max": 400 },
        { "name": "category", "type": "text", "max": 60 },
        { "name": "stock", "type": "integer", "min": 0, "default": 0 },
        { "name": "active", "type": "boolean", "default": true }
      ]
    },
    {
      "name": "orders",
      "access": "user",
      "columns": [
        { "name": "reference", "type": "text", "max": 24 },
        { "name": "items", "type": "json", "required": true },
        { "name": "subtotal", "type": "real", "required": true, "min": 0 },
        { "name": "shipping", "type": "real", "min": 0, "default": 0 },
        { "name": "total", "type": "real", "required": true, "min": 0 },
        { "name": "email", "type": "text", "format": "email", "required": true, "max": 160 },
        { "name": "ship_name", "type": "text", "required": true, "max": 80 },
        { "name": "ship_address", "type": "text", "required": true, "max": 300 },
        { "name": "ship_city", "type": "text", "max": 80 },
        { "name": "ship_postcode", "type": "text", "max": 20 },
        { "name": "status", "type": "text", "enum": ["pending", "processing", "shipped", "completed", "cancelled"], "default": "pending" }
      ]
    }
  ]
}
