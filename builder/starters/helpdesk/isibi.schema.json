{
  "tables": [
    {
      "name": "tickets",
      "access": "user",
      "teamRead": true,
      "trash": true,
      "timestamps": true,
      "fts": ["subject", "body", "requester"],
      "defaultSort": "-created_at",
      "sequence": { "field": "reference", "prefix": "TKT-", "pad": 4, "start": 1 },
      "sla": {
        "mins": 240,
        "start": "created_at",
        "done": { "field": "status", "values": ["resolved", "closed"] }
      },
      "columns": [
        { "name": "reference", "type": "text", "max": 24 },
        { "name": "subject", "type": "text", "required": true, "max": 160 },
        { "name": "body", "type": "text", "required": true, "max": 4000 },
        { "name": "requester", "type": "text", "required": true, "max": 80 },
        { "name": "requester_email", "type": "text", "format": "email", "max": 160 },
        { "name": "priority", "type": "text", "enum": ["urgent", "high", "normal", "low"], "default": "normal" },
        { "name": "status", "type": "text", "enum": ["open", "pending", "resolved", "closed"], "default": "open" },
        { "name": "category", "type": "text", "max": 60 }
      ],
      "transitions": {
        "status": {
          "open": ["pending", "resolved"],
          "pending": ["open", "resolved"],
          "resolved": ["closed", "open"],
          "closed": ["open"]
        }
      }
    },
    {
      "name": "replies",
      "access": "user",
      "teamRead": true,
      "timestamps": true,
      "columns": [
        { "name": "ticket_id", "type": "integer", "required": true, "ref": "tickets" },
        { "name": "author", "type": "text", "required": true, "max": 80 },
        { "name": "body", "type": "text", "required": true, "max": 4000 },
        { "name": "internal", "type": "boolean", "default": false }
      ]
    },
    {
      "name": "articles",
      "access": "admin",
      "timestamps": true,
      "fts": ["title", "body"],
      "columns": [
        { "name": "title", "type": "text", "required": true, "max": 160 },
        { "name": "summary", "type": "text", "max": 320 },
        { "name": "body", "type": "text", "required": true },
        { "name": "category", "type": "text", "max": 60 },
        { "name": "published", "type": "boolean", "default": true }
      ]
    }
  ]
}
