{
  "tables": [
    {
      "name": "leads",
      "access": "user",
      "teamRead": true,
      "trash": true,
      "timestamps": true,
      "fts": ["name", "company", "email", "notes"],
      "defaultSort": "-created_at",
      "columns": [
        { "name": "name", "type": "text", "required": true, "max": 80 },
        { "name": "company", "type": "text", "max": 120 },
        { "name": "email", "type": "text", "format": "email", "max": 160 },
        { "name": "phone", "type": "text", "max": 32 },
        { "name": "source", "type": "text", "enum": ["website", "referral", "outbound", "event", "inbound-call", "other"], "default": "website" },
        { "name": "status", "type": "text", "enum": ["new", "contacted", "qualified", "unqualified"], "default": "new" },
        { "name": "value", "type": "real", "min": 0, "default": 0 },
        { "name": "notes", "type": "text", "max": 2000 }
      ],
      "transitions": {
        "status": {
          "new": ["contacted", "unqualified"],
          "contacted": ["qualified", "unqualified"],
          "qualified": ["contacted"],
          "unqualified": ["new"]
        }
      }
    },
    {
      "name": "deals",
      "access": "user",
      "teamRead": true,
      "trash": true,
      "timestamps": true,
      "defaultSort": "-created_at",
      "columns": [
        { "name": "title", "type": "text", "required": true, "max": 120 },
        { "name": "company", "type": "text", "max": 120 },
        { "name": "contact_id", "type": "integer", "ref": "contacts" },
        { "name": "value", "type": "real", "required": true, "min": 0 },
        { "name": "stage", "type": "text", "enum": ["discovery", "proposal", "negotiation", "won", "lost"], "default": "discovery" },
        { "name": "probability", "type": "integer", "min": 0, "max": 100, "default": 20 },
        { "name": "close_date", "type": "text", "max": 10 },
        { "name": "lost_reason", "type": "text", "max": 200 }
      ],
      "transitions": {
        "stage": {
          "discovery": ["proposal", "lost"],
          "proposal": ["negotiation", "discovery", "lost"],
          "negotiation": ["won", "lost", "proposal"],
          "won": [],
          "lost": ["discovery"]
        }
      }
    },
    {
      "name": "contacts",
      "access": "user",
      "teamRead": true,
      "trash": true,
      "timestamps": true,
      "fts": ["name", "company", "email"],
      "columns": [
        { "name": "name", "type": "text", "required": true, "max": 80 },
        { "name": "role", "type": "text", "max": 80 },
        { "name": "company", "type": "text", "max": 120 },
        { "name": "email", "type": "text", "format": "email", "max": 160 },
        { "name": "phone", "type": "text", "max": 32 },
        { "name": "notes", "type": "text", "max": 2000 }
      ]
    }
  ]
}
