// gofarther-front — the front door for customer sites. Deployed by deploy.yml
// after the platform (owner: "do all 4", 2026-10-27).
//
// EVERY SITE ADDRESS ON gofarther.app (2026-10-27, after the rehearsal on the
// test bakery read right: pages, assets, robots, sitemap, 404s, all marked).
// `*.gofarther.app/*` is more specific than the platform's `*/*` on the same
// zone, so it wins without the platform's route being removed: no moment with
// no route, and the platform's stays as the fallback (the bare apex). Custom
// domains (the `*/*` on gofarther.dev's zone) are a separate step.
{
  "name": "gofarther-front",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-02",
  "workers_dev": false,
  // The one binding: a private, fixed link to the platform Worker.
  "routes": [
    { "pattern": "*.gofarther.app/*", "zone_name": "gofarther.app" },
    // CUSTOMERS' OWN DOMAINS (2026-10-27): Cloudflare for SaaS hostnames enter
    // gofarther.dev's zone and match this. gofarther.dev and www keep their
    // exact custom_domain routes on the platform, which win over this.
    { "pattern": "*/*", "zone_name": "gofarther.dev" }
  ],
  "services": [
    { "binding": "PLATFORM", "service": "isibi-app" }
  ]
}
