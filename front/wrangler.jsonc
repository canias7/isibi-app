// gofarther-front — the front door for customer sites. Deployed by deploy.yml
// after the platform (owner: "do all 4", 2026-10-27).
//
// THE REHEARSAL: one address only, the test bakery. A more specific route wins
// over the platform's `*/*`, so only this host comes through here; every other
// site is untouched. Moving `*/*` on `gofarther.app` and the custom-domain
// fallback here is the next step, after this one reads right.
{
  "name": "gofarther-front",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-02",
  "workers_dev": false,
  // The one binding: a private, fixed link to the platform Worker.
  "routes": [
    { "pattern": "fold-lane-bakery.gofarther.app/*", "zone_name": "gofarther.app" }
  ],
  "services": [
    { "binding": "PLATFORM", "service": "isibi-app" }
  ]
}
